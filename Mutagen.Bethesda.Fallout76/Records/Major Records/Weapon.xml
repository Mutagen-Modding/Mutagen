      <UInt16 name="Capacity" />
      <UInt16 name="AmmoPerShot" />
          <Enum name="AnimationType" enumName="Weapon.AnimationTypes" byteLength="1" />
          <Float name="SecondaryDamage" />
          <Float name="Weight" />
      <UInt32 name="Value" />
      <UInt16 name="BaseDamage" />
          <Enum name="SoundLevel" enumName="SoundLevel" byteLength="4" />
      <FormLink name="AttackSound" refName="SoundDescriptor" />
      <FormLink name="ThrowablePrimedSound" refName="SoundDescriptor" />
      <FormLink name="AttackLoopSound" refName="SoundDescriptor" />
      <FormLink name="AttackFailSound" refName="SoundDescriptor" />
      <FormLink name="IdleSound" refName="SoundDescriptor" />
      <FormLink name="EquipSound" refName="SoundDescriptor" />
      <FormLink name="UnequipSound" refName="SoundDescriptor" />
      <FormLink name="FastEquipSound" refName="SoundDescriptor" />
      <UInt8 name="AccuracyBonus" />
          <Float name="AnimationAttackSeconds" />
      <UInt16 name="Rank" />
          <Float name="ActionPointCost" />
          <Float name="FullPowerSeconds" />
          <Float name="MinPowerPerShot" />
          <Enum name="Stagger" enumName="Stagger" byteLength="4" />
          <Float name="ColorRemappingIndex" />
      <UInt32 name="Health" />
      <ByteArray name="Unknown2" byteLength="8" nullable="False" />
          <Float name="OverheatRateUp" />
          <Float name="OverheatRateDown" />
      <ByteArray name="Unknown3" byteLength="4" nullable="False" />
        </Fields>
      </Data>
      <RefDirect name="RangedWeaponData" refName="RangedWeaponData" />
      <Data recordType="CRDT">
        <Fields>
          <Float name="CritDamageMult" />
          <Float name="CritChargeBonus" />
      <FormLink name="CritEffect" refName="Spell" />
        </Fields>
      </Data>
      <FormLink name="ImpactDataSet" recordType="INAM" refName="Fallout76MajorRecord" />
      <FormLink name="NpcAddAmmoList" recordType="LNAM" refName="Fallout76MajorRecord" />
      <FormLink name="AimModel" recordType="WAMD" refName="AimModel" />
      <FormLink name="AimAssistModel" recordType="WAAM" refName="Fallout76MajorRecord" />
      <FormLink name="Zoom" recordType="WZMD" refName="Zoom" />
      <FormLink name="Template" recordType="CNAM" refName="Fallout76MajorRecord" />
      <RefList name="DamageTypes" refName="WeaponDamageType" recordType="DAMA" />
      <String name="Filter" recordType="FLTR" />
      <FormLink name="ValueCurrency" recordType="VCRY" refName="Fallout76MajorRecord" />
      <Float name="MinimumChargeTime" recordType="WMCT" />
      <FormLink name="DamageCurve" recordType="CVT0" refName="Fallout76MajorRecord" />
      <FormLink name="MinDurabilityCurve" recordType="CVT1" refName="Fallout76MajorRecord" />
