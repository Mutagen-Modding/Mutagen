      <FormLink name="BashConditionLossScale" recordType="CVT3" refName="Fallout76MajorRecord" />
      <FormLink name="MaxDurabilityCurve" recordType="CVT4" refName="Fallout76MajorRecord" />
      <FormLink name="UnknownCurve" recordType="CVT5" refName="Fallout76MajorRecord" />
      <Enum name="MeleeSpeed" recordType="MASE" enumName="Weapon.MeleeSpeeds" />
      <Float name="TelegraphTime" recordType="WTDT" />
      <FormLink name="TelegraphVisual" recordType="WTDA" refName="Fallout76MajorRecord" />
      <FormLink name="TelegraphSound" recordType="WTDS" refName="SoundDescriptor" />
      <Float name="SneakAttackMultiplier" recordType="WSAM" />
      <ByteArray name="DAMS2" recordType="DAMS" />
    </Fields>
    <LinkInterface>IObjectId</LinkInterface>
    <LinkInterface>IBindableEquipment</LinkInterface>
    <LinkInterface>IStaticTarget</LinkInterface>
    <LinkInterface>IPlaceableObject</LinkInterface>
    <LinkInterface>IReferenceableObject</LinkInterface>
    <LinkInterface>IHarvestTarget</LinkInterface>
    <LinkInterface>IFurnitureAssociation</LinkInterface>
    <LinkInterface>IExplodeSpawn</LinkInterface>
    <LinkInterface>IItem</LinkInterface>
    <LinkInterface>IConstructibleObjectTarget</LinkInterface>
  </Object>
  <Object name="WeaponDamageType" objType="Subrecord">
    <Fields>
      <FormLink name="DamageType" refName="ADamageType" />
      <UInt32 name="Value" />
    </Fields>
  </Object>
  <Object name="RangedWeaponData" recordType="RGW3" objType="Subrecord">
    <Fields>
      <FormLink name="OverrideProjectile" refName="Projectile" />
      <Float name="AnimationFireSeconds" />
      <Float name="RumbleLeftMotorStrength" />
      <Float name="RumbleRightMotorStrength" />
      <Float name="RumbleDuration" />
      <Float name="AnimationReloadSeconds" />
      <Float name="BoltDrawSpeed" />
      <Float name="SightedTransitionSeconds" />
      <Float name="UnsightedTransitionSeconds" />
      <Float name="MinWeaponDrawTime" />
