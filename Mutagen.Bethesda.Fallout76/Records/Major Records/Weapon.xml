      <ByteArray name="FNAM" recordType="FNAM" />
      <Bool name="OBTF" recordType="OBTF" boolAsMarker="True" />
      <ByteArray name="OBTS" recordType="OBTS" />
      <ByteArray name="RGW2" recordType="RGW2" />
      <Bool name="STOP" recordType="STOP" boolAsMarker="True" />
      <RefDirect name="DAMS" refName="WeaponDAMSData" />
</Fields>
  </Object>
  <Object name="WeaponDAMSData" objType="Subrecord" recordType="DAMS">
    <Fields>
      <UInt32 name="Field1" />
      <UInt32 name="Field2" />
      <UInt32 name="Field3" />
          <ByteArray name="OPDS" recordType="OPDS" />
</Fields>
  </Object>
</Loqui>
