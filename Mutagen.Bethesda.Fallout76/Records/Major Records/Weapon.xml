      <FormLink name="PreviewTransform" recordType="PTRN" refName="Transform" />
      <FormLink name="AnimationSound" recordType="STCP" refName="AnimationSoundTagSet" />
      <FormLink name="SnapshotTemplate" recordType="SNTP" refName="Fallout76MajorRecord" />
      <UInt32 name="PHST" recordType="PHST" />
      <ByteArray name="XALG" recordType="XALG" />
      <RefList name="ObjectPlacementDefaults" refName="ObjectPlacementDefault" />
      <String name="Name" recordType="FULL" translated="Normal" />
      <RefDirect name="Model" refName="Model" />
      <RefDirect name="Icons" refName="Icons" />
      <FormLink name="ObjectEffect" recordType="EITM" refName="ObjectEffect" />
      <UInt16 name="EnchantmentAmount" recordType="EAMT" />
      <RefDirect name="Destructible" refName="Destructible" />
      <FormLink name="EquipmentType" recordType="ETYP" refName="EquipType" />
      <FormLink name="BlockBashImpactDataSet" recordType="BIDS" refName="ImpactDataSet" />
