<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Mutagen.Bethesda.Tests.GUI"
    xmlns:views="using:Mutagen.Bethesda.Tests.GUI.Views"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Mutagen.Bethesda.Tests.GUI.Views.MainView">
    <Grid>
        <views:ConfigurationView IsVisible="{Binding RunningTests, Converter={StaticResource IsNull}}" />
        <ContentControl Content="{Binding RunningTests}"
                        IsVisible="{Binding RunningTests, Converter={StaticResource NotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:RunningTestsVM">
                    <views:TestResultsView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
