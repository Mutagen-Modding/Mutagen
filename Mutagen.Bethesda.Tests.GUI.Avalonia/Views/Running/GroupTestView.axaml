<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Mutagen.Bethesda.Tests.GUI"
    xmlns:views="using:Mutagen.Bethesda.Tests.GUI.Views"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="60"
    x:Class="Mutagen.Bethesda.Tests.GUI.Views.GroupTestView">
    <Grid Margin="0,0,0,10" Background="Transparent" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Background="Transparent">
            <Border Margin="5,0,-5,0" CornerRadius="4"
                    Background="{Binding State, Converter={StaticResource TestStateToBrush}}" />
            <TextBlock Margin="15,3,45,3" FontSize="15" Text="{Binding Name}" />
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding PassthroughDisplay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PassthroughTestVM">
                    <views:PassthroughTestView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
