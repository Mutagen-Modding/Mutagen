<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Mutagen.Bethesda.Tests.GUI.Views"
    mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="50"
    x:Class="Mutagen.Bethesda.Tests.GUI.Views.TestBubbleView">
    <Grid>
        <Border Background="{StaticResource AccentBrush}"
                CornerRadius="5" Opacity="0.25"
                IsVisible="{Binding IsSelected}" />
        <Border Margin="4" BorderThickness="1.5" CornerRadius="5"
                Background="{Binding State, Converter={StaticResource TestStateToBrush}}"
                BorderBrush="{Binding IsSelected, Converter={StaticResource SelectedToBorderBrush}}">
            <TextBlock Margin="5" VerticalAlignment="Center"
                       Text="{Binding Test, Converter={x:Static views:TestBubbleView.DisplayNameConverter}}" />
        </Border>
    </Grid>
</UserControl>
