<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="Sound" objType="Record" baseClass="Fallout3MajorRecord" recordType="SOUN">
    <Fields>
      <RefDirect name="ObjectBounds" refName="ObjectBounds" />
      <String name="File" recordType="FNAM" />
      <UInt8 name="RandomChancePercent" recordType="RNAM">
        <ModHeaderVersioning version="1.32" />
      </UInt8>
      <RefDirect name="Data" refName="SoundData" />
      <Array name="AttenuationCurve" fixedSize="5" recordType="ANAM" >
        <Int16 />
      </Array>
      <Int16 name="ReverbAttenuationControl" recordType="GNAM" />
      <Int32 name="Priority" recordType="HNAM" />
    </Fields>
    <LinkInterface>IPlaceableObject</LinkInterface>
    <LinkInterface>IExplodeSpawn</LinkInterface>
  </Object>
  <Object name="SoundData" objType="Subrecord" recordType="SNDX">
    <Fields>
      <UInt8 name="MinimumAttenuationDistance" />
      <UInt8 name="MaximumAttenuationDistance" />
      <Int8 name="FrequencyAdjustment" />
      <UInt8 name="Unused" />
      <Enum name="Flags" enumName="SoundData.Flag" byteLength="4" />
      <Int16 name="StaticAttenuationCdB" />
      <UInt8 name="StopTime" />
      <UInt8 name="StartTime" />
    </Fields>
  </Object>
  <Object name="SoundDataExtended" baseClass="SoundData" objType="Subrecord" recordType="SNDD">
    <Fields>
      <Array name="AttenuationCurve" fixedSize="5" >
        <Int16 />
      </Array>
      <Int16 name="ReverbAttenuationControl" />
      <Int32 name="Priority" />
      <Int32 name="LoopBegin" />
      <Int32 name="LoopEnd" />
    </Fields>
  </Object>
</Loqui>
