<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="ImageSpace" objType="Record" baseClass="Fallout3MajorRecord"
          recordType="IMGS">
    <Fields>
      <RefDirect name="Data" refName="ImageSpaceData" nullable="False" />
    </Fields>
  </Object>
  <Object name="ImageSpaceData" objType="Subrecord" recordType="DNAM">
    <Fields>
      <!-- HDR -->
      <Float name="HdrEyeAdaptSpeed" />
      <Float name="HdrBlurRadius" />
      <Float name="HdrBlurPasses" />
      <Float name="HdrEmissiveMult" />
      <Float name="HdrTargetLum" />
      <Float name="HdrUpperLumClamp" />
      <Float name="HdrBrightScale" />
      <Float name="HdrBrightClamp" />
      <Float name="HdrLumRampNoTex" />
      <Float name="HdrLumRampMin" />
      <Float name="HdrLumRampMax" />
      <Float name="HdrSunlightDimmer" />
      <Float name="HdrGrassDimmer" />
      <Float name="HdrTreeDimmer" />
      <Float name="HdrSkinDimmer">
        <Versioning formVersion="10" action="Add" />
      </Float>
      <!-- Bloom -->
      <Float name="BloomBlurRadius" />
      <Float name="BloomAlphaMultInterior" />
      <Float name="BloomAlphaMultExterior" />
      <!-- Get Hit -->
      <Float name="GetHitBlurRadius" />
      <Float name="GetHitBlurDampingConstant" />
      <Float name="GetHitDampingConstant" />
      <!-- Night Eye -->
      <Color name="NightEyeTintColor" binaryType="NoAlphaFloat" />
      <Float name="NightEyeBrightness" />
      <!-- Cinematic -->
      <Float name="CinematicSaturation" />
      <Float name="CinematicContrastAvgLumValue" />
      <Float name="CinematicContrastValue" />
      <Float name="CinematicBrightnessValue" />
      <Color name="CinematicTintColor" binaryType="NoAlphaFloat" />
      <Float name="CinematicTintValue" />
      <!-- Trailing Unknown (always present) -->
      <ByteArray name="Unknown" byteLength="4" nullable="False" />
      <!-- v10+ -->
      <ByteArray name="Unused1" byteLength="4" nullable="False">
        <Versioning formVersion="10" action="Add" />
      </ByteArray>
      <ByteArray name="Unused2" byteLength="4" nullable="False">
        <Versioning formVersion="10" action="Add" />
      </ByteArray>
      <ByteArray name="Unused3" byteLength="4" nullable="False">
        <Versioning formVersion="10" action="Add" />
      </ByteArray>
      <!-- v13+ -->
      <Enum name="Flags" enumName="ImageSpace.Flag" byteLength="1">
        <Versioning formVersion="13" action="Add" />
      </Enum>
      <ByteArray name="Unused4" byteLength="3" nullable="False">
        <Versioning formVersion="13" action="Add" />
      </ByteArray>
    </Fields>
  </Object>
</Loqui>
