<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="DialogResponses" recordType="INFO" objType="Record" baseClass="Fallout3MajorRecord">
    <Fields>
      <RefDirect name="Data" refName="DialogResponsesData" nullable="False" />
      <FormLink name="Quest" recordType="QSTI" refName="Quest" nullable="False" />
      <FormLink name="PreviousTopic" recordType="TPIC" refName="DialogTopic" />
      <FormLink name="PreviousInfo" recordType="PNAM" refName="DialogResponses" />
      <List name="AddTopics">
        <FormLink recordType="NAME" refName="DialogTopic" />
      </List>
      <RefList name="Responses" refName="DialogResponse" />
      <RefList name="Conditions" refName="Condition" />
      <List name="Choices">
        <FormLink recordType="TCLT" refName="DialogTopic" />
      </List>
      <List name="LinkFrom">
        <FormLink recordType="TCLF" refName="DialogTopic" />
      </List>
      <List name="FollowUp">
        <FormLink recordType="TCFU" refName="DialogResponses" />
        <ModHeaderVersioning version="1.32" />
      </List>
      <RefDirect name="BeginScript" refName="ScriptFields" />
      <!-- The End script group is preceded by an empty NEXT marker; fold it into EndScript. -->
      <RefDirect name="EndScript" refName="ScriptFields" markerType="NEXT" />
      <FormLink name="UnusedSound" recordType="SNDD" refName="Sound" />
      <String name="Prompt" recordType="RNAM" />
      <FormLink name="Speaker" recordType="ANAM">
        <Interface>INpcSpawn</Interface>
      </FormLink>
      <FormLink name="ActorValuePerk" recordType="KNAM">
        <Interface>IActorValueOrPerk</Interface>
      </FormLink>
      <Enum name="SpeechChallenge" recordType="DNAM" enumName="DialogResponses.SpeechChallengeEnum" byteLength="4" />
    </Fields>
  </Object>
  <Object name="DialogResponsesData" objType="Subrecord" recordType="DATA">
    <Fields>
      <Enum name="Type" enumName="DialogResponses.InfoType" byteLength="1" />
      <Enum name="NextSpeaker" enumName="DialogResponses.NextSpeakerType" byteLength="1" />
      <Enum name="Flags" enumName="DialogResponses.InfoFlag" byteLength="2" binary="Custom" />
    </Fields>
  </Object>
  <Object name="DialogResponse" objType="Subrecord">
    <Fields>
      <RefDirect name="ResponseData" refName="DialogResponseData" nullable="False" binary="Custom" />
      <String name="ResponseText" recordType="NAM1" nullable="False" />
      <String name="ScriptNotes" recordType="NAM2" nullable="False" />
      <String name="Edits" recordType="NAM3" />
      <FormLink name="SpeakerAnimation" recordType="SNAM" refName="IdleAnimation" />
      <FormLink name="ListenerAnimation" recordType="LNAM" refName="IdleAnimation" />
    </Fields>
  </Object>
  <Object name="DialogResponseData" objType="Subrecord" recordType="TRDT">
    <Fields>
      <Enum name="EmotionType" enumName="DialogResponses.EmotionType" byteLength="4" />
      <Int32 name="EmotionValue" />
      <UInt32 name="Unused1" />
      <UInt8 name="ResponseNumber" />
      <ByteArray name="Unused2" byteLength="3" nullable="False" />
      <Break />
      <FormLink name="ResponseSound" refName="Sound" />
      <Break />
      <Bool name="UseEmotionAnimation" byteLength="1" />
      <ByteArray name="Unused3" byteLength="3" nullable="False" />
    </Fields>
  </Object>
</Loqui>
