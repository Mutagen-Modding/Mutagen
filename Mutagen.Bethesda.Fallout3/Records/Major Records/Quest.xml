<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="Quest" objType="Record" baseClass="Fallout3MajorRecord"
          recordType="QUST">
    <Fields>
      <FormLink name="Script" recordType="SCRI" refName="Script" />
      <String name="Name" recordType="FULL" />
      <RefDirect name="Icons" refName="Icons" />
      <RefDirect name="QuestData" refName="QuestData" />
      <RefList name="Conditions" refName="Condition" />
      <RefList name="Stages" refName="QuestStage" />
      <RefList name="Objectives" refName="QuestObjective" />
    </Fields>
  </Object>
  <Object name="QuestStage" objType="Subrecord">
    <Fields>
      <Data recordType="INDX">
        <Fields>
          <Int16 name="Index" />
        </Fields>
      </Data>
      <RefList name="LogEntries" refName="QuestLogEntry" />
    </Fields>
  </Object>
  <Object name="QuestLogEntry" objType="Subrecord">
    <Fields>
      <Enum name="Flags" enumName="QuestLogEntry.Flag" byteLength="1" recordType="QSDT" />
      <RefList name="Conditions" refName="Condition" />
      <String name="Entry" recordType="CNAM" />
      <RefDirect name="EmbeddedScript" refName="ScriptFields" singleton="true" nullable="False" />
      <FormLink name="NextQuest" refName="Quest" recordType="NAM0" />
    </Fields>
  </Object>
  <Object name="QuestObjective" objType="Subrecord">
    <Fields>
      <Int32 name="Index" recordType="QOBJ" nullable="False" />
      <String name="DisplayText" recordType="NNAM" />
      <RefList name="Targets" refName="QuestObjectiveTarget" />
    </Fields>
  </Object>
  <Object name="QuestObjectiveTarget" objType="Subrecord">
    <Fields>
      <Data recordType="QSTA">
        <Fields>
          <FormLink name="Target" refName="Fallout3MajorRecord" />
          <UInt32 name="Flags" />
        </Fields>
      </Data>
      <RefList name="Conditions" refName="Condition" />
    </Fields>
  </Object>
  <Object name="QuestData" objType="Subrecord" recordType="DATA">
    <Fields>
      <UInt8 name="Flags" />
      <UInt8 name="Priority" />
      <Break />
      <ByteArray name="Unused" byteLength="2" nullable="False" />
      <Break />
      <Float name="QuestDelay" />
    </Fields>
  </Object>
</Loqui>
