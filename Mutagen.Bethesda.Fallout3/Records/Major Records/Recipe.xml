<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="Recipe" objType="Record" baseClass="Fallout3MajorRecord"
          recordType="RCPE">
    <Fields>
      <String name="Name" recordType="FULL" translated="Normal" />
      <RefList name="Conditions" refName="Condition" />
      <Data recordType="DATA">
        <Fields>
          <Enum name="Skill" enumName="ActorValue" byteLength="4" />
          <UInt32 name="Level" />
          <FormLink name="Category" refName="RecipeCategory" />
          <FormLink name="SubCategory" refName="RecipeCategory" />
        </Fields>
      </Data>
      <RefList name="Ingredients" refName="RecipeIngredient" />
      <RefList name="Outputs" refName="RecipeOutput" />
    </Fields>
  </Object>
  <Object name="RecipeIngredient" objType="Subrecord">
    <Fields>
      <FormLink name="Item" recordType="RCIL">
        <Interface>IRecipeItem</Interface>
      </FormLink>
      <UInt32 name="Quantity" recordType="RCQY" />
    </Fields>
  </Object>
  <Object name="RecipeOutput" objType="Subrecord">
    <Fields>
      <FormLink name="Item" recordType="RCOD">
        <Interface>IRecipeItem</Interface>
      </FormLink>
      <UInt32 name="Quantity" recordType="RCQY" />
    </Fields>
  </Object>
</Loqui>
