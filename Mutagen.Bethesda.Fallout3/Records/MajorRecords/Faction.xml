<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="Faction" objType="Record" baseClass="Fallout3MajorRecord" recordType="FACT">
    <Fields>
      <String name="Name" recordType="FULL" />
      <RefList name="Relations" refName="Relation" />
      <RefDirect name="Data" refName="FactionData" nullable="False" />
      <Float name="CrimeGoldMultiplier" recordType="CNAM" nullable="True" />
      <RefList name="Ranks" refName="Rank" />
    </Fields>
    <LinkInterface>IRelatable</LinkInterface>
    <LinkInterface>IOwner</LinkInterface>
  </Object>
  <Object name="FactionData" objType="Subrecord" recordType="DATA">
    <Fields>
      <!-- Required field (xEdit element 0): Flags1 -->
      <UInt8 name="Flags1" />
      <!-- Optional from xEdit element 1: Flags2, Unused -->
      <ByteArray name="Remaining" />
    </Fields>
  </Object>
  <Object name="Rank" objType="Subrecord">
    <Fields>
      <Int32 name="RankNumber" recordType="RNAM" />
      <Gendered name="Name" maleMarker="MNAM" femaleMarker="FNAM">
        <Fields>
          <String />
        </Fields>
      </Gendered>
      <String name="Insignia" recordType="INAM" />
    </Fields>
  </Object>
</Loqui>
