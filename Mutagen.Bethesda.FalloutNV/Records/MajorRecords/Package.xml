<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="Package" objType="Record" baseClass="FalloutNVMajorRecord"
          recordType="PACK">
    <Fields>
      <Data recordType="PKDT">
        <Fields>
          <UInt32 name="Flags" />
          <UInt8 name="Type" />
          <UInt8 name="Unused" />
          <UInt16 name="FalloutBehaviorFlags" />
          <UInt16 name="TypeSpecificFlags" />
          <ByteArray name="Unused2" byteLength="2" nullable="False" />
        </Fields>
      </Data>
      <Data recordType="PLDT">
        <Fields>
          <Int32 name="LocationType" />
          <FormLink name="LocationValue" refName="FalloutNVMajorRecord" />
          <Int32 name="LocationRadius" />
        </Fields>
      </Data>
      <Data recordType="PLD2">
        <Fields>
          <Int32 name="Location2Type" />
          <FormLink name="Location2Value" refName="FalloutNVMajorRecord" />
          <Int32 name="Location2Radius" />
        </Fields>
      </Data>
      <Data recordType="PSDT">
        <Fields>
          <Int8 name="ScheduleMonth" />
          <UInt8 name="ScheduleDayOfWeek" />
          <UInt8 name="ScheduleDate" />
          <Int8 name="ScheduleHour" />
          <Int8 name="ScheduleMinute" />
          <ByteArray name="Unused3" byteLength="3" nullable="False" />
          <Int32 name="ScheduleDurationInMinutes" />
        </Fields>
      </Data>
      <Data recordType="PTDT">
        <Fields>
          <Int32 name="TargetType" />
          <FormLink name="TargetValue" refName="FalloutNVMajorRecord" />
          <Int32 name="TargetCountOrDistance" />
        </Fields>
      </Data>
      <RefList name="Conditions" refName="Condition" />
      <RefDirect name="IdleAnimations" refName="PackageIdles" />
      <FormLink name="CombatStyle" recordType="CNAM" refName="CombatStyle" />
      <Bool name="EatMarker" boolAsMarker="PKED" />
      <UInt32 name="EscortDistance" recordType="PKE2" />
      <Float name="FollowTriggerRadius" recordType="PKFD" />
      <ByteArray name="PatrolFlags" recordType="PKPT" />
      <Data recordType="PKW3">
        <Fields>
          <UInt32 name="WeaponFlags" />
          <UInt8 name="FireRate" />
          <UInt8 name="FireCount" />
          <UInt16 name="NumberOfBursts" />
          <UInt16 name="ShootsPerVolleyMin" />
          <UInt16 name="ShootsPerVolleyMax" />
          <Float name="PauseBetweenVolleysMin" />
          <Float name="PauseBetweenVolleysMax" />
          <ByteArray name="Unused4" byteLength="4" nullable="False" />
        </Fields>
      </Data>
      <Data recordType="PTD2">
        <Fields>
          <Int32 name="Target2Type" />
          <FormLink name="Target2Value" refName="FalloutNVMajorRecord" />
          <Int32 name="Target2CountOrDistance" />
        </Fields>
      </Data>
      <Bool name="UseItemMarker" boolAsMarker="PUID" />
      <Bool name="AmbushMarker" boolAsMarker="PKAM" />
      <ByteArray name="PKDD" recordType="PKDD" />
      <RefDirect name="OnBegin" refName="PackageEvent" markerType="POBA" />
      <RefDirect name="OnEnd" refName="PackageEvent" markerType="POEA" />
      <RefDirect name="OnChange" refName="PackageEvent" markerType="POCA" />
    </Fields>
  </Object>
  <Object name="PackageIdles" objType="Subrecord">
    <Fields>
      <Enum name="Type" enumName="PackageIdles.Types" byteLength="4" nullable="False" recordType="IDLF" />
      <Float name="TimerSetting" recordType="IDLT" nullable="False" />
      <List name="Animations" recordType="IDLA" counterRecType="IDLC" counterLength="1" binary="Custom" nullable="False">
        <FormLink refName="IdleAnimation" />
      </List>
      <ByteArray name="IDLB" recordType="IDLB" />
    </Fields>
  </Object>
  <Object name="PackageEvent" objType="Subrecord">
    <Fields>
      <FormLink name="Idle" refName="IdleAnimation" recordType="INAM" nullable="False" />
      <RefDirect name="EmbeddedScript" refName="ScriptFields" singleton="true" nullable="False" />
      <FormLink name="Topic" recordType="TNAM" refName="DialogTopic" />
    </Fields>
  </Object>
</Loqui>
