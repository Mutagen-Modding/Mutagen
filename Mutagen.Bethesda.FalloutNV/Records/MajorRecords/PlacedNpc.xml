    <LinkInterface>IPlaced</LinkInterface>
  </Object>
  <Object name="PlacedNpcLinkedReferenceColor" objType="Subrecord" recordType="XCLP">
    <Fields>
      <Color name="Start" binaryType="Alpha" />
      <Color name="End" binaryType="Alpha" />
    </Fields>
  </Object>
  <Object name="LinkedDecal" objType="Subrecord" recordType="XDCR">
    <Fields>
      <FormLink name="Reference" refName="PlacedObject" />
      <ByteArray name="Unknown" />
    </Fields>
  </Object>
</Loqui>
