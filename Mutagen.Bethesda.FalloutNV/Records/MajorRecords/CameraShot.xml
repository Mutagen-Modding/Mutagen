<?xml version="1.0" encoding="us-ascii"?>
<Loqui xmlns="http://tempuri.org/LoquiSource.xsd">
  <Object name="CameraShot" objType="Record" baseClass="FalloutNVMajorRecord"
          recordType="CAMS">
    <Fields>
      <RefDirect name="Model" refName="Model" />
      <RefDirect name="Data" refName="CameraShotData" nullable="False" />
      <FormLink name="ImageSpaceModifier" refName="ImageSpaceAdapter" recordType="MNAM" />
    </Fields>
  </Object>
  <Object name="CameraShotData" objType="Subrecord" recordType="DATA">
    <Fields>
      <!-- Required fields (xEdit elements 0-6) -->
      <Enum name="Action" enumName="CameraShotAction" byteLength="4" />
      <Enum name="Location" enumName="CameraShotLocation" byteLength="4" />
      <Enum name="Target" enumName="CameraShotLocation" byteLength="4" />
      <Enum name="Flags" enumName="CameraShotFlag" byteLength="4" />
      <Float name="TimeMultiplierPlayer" />
      <Float name="TimeMultiplierTarget" />
      <Float name="TimeMultiplierGlobal" />
      <!-- Optional from xEdit element 7: MaxTime, MinTime, TargetPercentBetweenActors -->
      <ByteArray name="Remaining" />
    </Fields>
  </Object>
</Loqui>
